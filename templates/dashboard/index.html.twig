{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}
{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}
{% block body %}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{{ 'dashboard.hello'|trans({'%name%': app.user.name|split(' ')|first}) }}</h1>
        <p class="mt-1 text-sm text-muted">{{ 'dashboard.today'|trans({'%date%': today|format_date('full', locale: app.request.locale)}) }}</p>
    </div>
    <a href="{{ path('app_absence_new') }}" class="btn-primary hidden sm:inline-flex">{{ icons.icon('plus', 'h-4 w-4') }}{{ 'nav.new_absence'|trans }}</a>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        {{ include('_partials/account.html.twig') }}

        {% if is_granted('ROLE_TEAM_LEAD') %}
            <section class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        {{ 'dashboard.pending_title'|trans }}
                        <span class="font-normal text-muted">· {{ (is_granted('ROLE_ADMIN') ? 'dashboard.scope_all' : 'dashboard.scope_team')|trans }}</span>
                    </h2>
                    <span class="badge-requested">{{ pending|length }}</span>
                </div>
                {% if pending is empty %}
                    <p class="flex items-center gap-2 px-5 py-5 text-sm text-muted">{{ icons.icon('check', 'h-4 w-4 text-emerald-500') }}{{ 'dashboard.pending_empty'|trans }}</p>
                {% else %}
                    <ul class="divide-y divide-line">
                        {% for absence in pending %}
                            <li class="px-5 py-4" id="pending-{{ absence.id }}">
                                <div class="flex items-start gap-3">
                                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-2 text-xs font-semibold text-fg">{{ absence.user.initials }}</span>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium text-fg">{{ absence.user.name }} <span class="text-sm font-normal text-muted">· {{ absence.user.team }}</span></p>
                                        <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-sm text-muted">
                                            <span class="swatch" style="background: {{ absence.type.color }}"></span>
                                            <span class="text-fg">{{ absence.type|type_name }}</span> · {{ include('_partials/period.html.twig') }} ·
                                            <strong class="text-fg">{{ (absence.workingDays == 1 ? 'absence.working_day_one'|trans : 'absence.working_days'|trans({'%days%': absence.workingDays|days})) }}</strong>
                                        </p>
                                        {% if absence.comment %}<p class="mt-1.5 rounded-lg bg-surface-2 px-3 py-2 text-sm italic text-muted">„{{ absence.comment }}“</p>{% endif %}
                                    </div>
                                </div>
                                {% if is_granted('ABSENCE_DECIDE', absence) %}
                                    <form method="post" action="{{ path('app_absence_decide', {id: absence.id}) }}" class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:pl-13">
                                        <input type="hidden" name="_token" value="{{ csrf_token('decide' ~ absence.id) }}">
                                        <label class="sr-only" for="comment-{{ absence.id }}">{{ 'dashboard.comment'|trans }}</label>
                                        <input id="comment-{{ absence.id }}" name="comment" type="text" placeholder="{{ 'dashboard.comment_placeholder'|trans }}" class="input min-w-0 flex-1 py-2">
                                        <div class="flex gap-2">
                                            <button name="decision" value="approve" class="btn flex-1 bg-emerald-600 py-2 text-white hover:bg-emerald-700">{{ icons.icon('check', 'h-4 w-4') }}{{ 'dashboard.approve'|trans }}</button>
                                            <button name="decision" value="reject" class="btn flex-1 border border-line bg-surface py-2 text-red-700 hover:bg-red-50 dark:text-red-300 dark:hover:bg-red-500/10">{{ icons.icon('x', 'h-4 w-4') }}{{ 'dashboard.reject'|trans }}</button>
                                        </div>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        <section class="card">
            <div class="card-header">
                <h2 class="card-title">{{ 'dashboard.upcoming_title'|trans }}</h2>
                <a href="{{ path('app_absence_index') }}" class="text-xs font-medium text-accent hover:underline">{{ 'nav.absences'|trans }} →</a>
            </div>
            {% if upcoming is empty %}
                <p class="px-5 py-5 text-sm text-muted">{{ 'dashboard.upcoming_empty'|trans }}</p>
            {% else %}
                <ul class="divide-y divide-line">
                    {% for absence in upcoming %}
                        <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3.5 text-sm">
                            <span class="flex min-w-0 items-center gap-2">
                                <span class="swatch" style="background: {{ absence.type.color }}"></span>
                                <span class="font-medium text-fg">{{ absence.type|type_name }}</span>
                                <span class="text-muted">{{ include('_partials/period.html.twig') }}</span>
                            </span>
                            {{ include('_partials/status_badge.html.twig') }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    <section class="card h-fit">
        <div class="card-header">
            <h2 class="card-title">{{ 'dashboard.absent_today'|trans }}</h2>
            <span class="badge-neutral">{{ absentToday|length }}</span>
        </div>
        {% if absentToday is empty %}
            <p class="px-5 py-5 text-sm text-muted">{{ 'dashboard.absent_today_empty'|trans }}</p>
        {% else %}
            <ul class="divide-y divide-line">
                {% for absence in absentToday %}
                    <li class="flex items-center gap-3 px-5 py-3 text-sm">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-2 text-xs font-semibold text-fg">{{ absence.user.initials }}</span>
                        <span class="min-w-0">
                            <span class="block truncate font-medium text-fg">{{ absence.user.name }}</span>
                            <span class="flex items-center gap-1.5 text-muted">
                                <span class="swatch h-2 w-2" style="background: {{ absence_color(absence) }}"></span>
                                {{ absence_label(absence) }}{% if absence.status == 'requested' %} {{ 'dashboard.requested_suffix'|trans }}{% endif %} · {{ 'dashboard.until'|trans({'%date%': absence.endDate|ldate('format.day_month')}) }}
                            </span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
