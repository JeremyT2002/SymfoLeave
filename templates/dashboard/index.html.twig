{% extends 'base.html.twig' %}
{% block title %}Übersicht{% endblock %}
{% block body %}
<div class="flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="text-2xl font-semibold text-slate-900">Hallo {{ app.user.name|split(' ')|first }}!</h1>
        <p class="text-sm text-slate-600">Heute ist {{ today|format_date('full', locale='de') }}.</p>
    </div>
    <a href="{{ path('app_absence_new') }}" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">+ Abwesenheit beantragen</a>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        {{ include('_partials/account.html.twig') }}

        {% if is_granted('ROLE_TEAM_LEAD') %}
            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">
                    Offene Anträge {{ is_granted('ROLE_ADMIN') ? '(alle Teams)' : '(dein Team)' }}
                    <span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-900">{{ pending|length }}</span>
                </h2>
                {% if pending is empty %}
                    <p class="px-5 py-4 text-sm text-slate-500">Keine offenen Anträge. 🎉</p>
                {% else %}
                    <ul class="divide-y divide-slate-100">
                        {% for absence in pending %}
                            <li class="px-5 py-4" id="pending-{{ absence.id }}">
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <div>
                                        <p class="font-medium text-slate-900">{{ absence.user.name }} <span class="text-sm font-normal text-slate-500">· {{ absence.user.team }}</span></p>
                                        <p class="text-sm text-slate-700">
                                            <span class="inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background: {{ absence.type.color }}"></span>
                                            {{ absence.type.name }} · {{ include('_partials/period.html.twig') }} · <strong>{{ absence.workingDays|days }}</strong> Arbeitstag{{ absence.workingDays == 1 ? '' : 'e' }}
                                        </p>
                                        {% if absence.comment %}<p class="mt-1 text-sm italic text-slate-600">„{{ absence.comment }}“</p>{% endif %}
                                    </div>
                                </div>
                                {% if is_granted('ABSENCE_DECIDE', absence) %}
                                    <form method="post" action="{{ path('app_absence_decide', {id: absence.id}) }}" class="mt-3 flex flex-wrap items-center gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('decide' ~ absence.id) }}">
                                        <label class="sr-only" for="comment-{{ absence.id }}">Kommentar</label>
                                        <input id="comment-{{ absence.id }}" name="comment" type="text" placeholder="Kommentar (optional)" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
                                        <button name="decision" value="approve" class="rounded-lg bg-green-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-800">Genehmigen</button>
                                        <button name="decision" value="reject" class="rounded-lg bg-red-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-800">Ablehnen</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">Meine nächsten Abwesenheiten</h2>
            {% if upcoming is empty %}
                <p class="px-5 py-4 text-sm text-slate-500">Nichts geplant.</p>
            {% else %}
                <ul class="divide-y divide-slate-100">
                    {% for absence in upcoming %}
                        <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3 text-sm">
                            <span>
                                <span class="inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background: {{ absence.type.color }}"></span>
                                <span class="font-medium">{{ absence.type.name }}</span> · {{ include('_partials/period.html.twig') }}
                            </span>
                            {{ include('_partials/status_badge.html.twig') }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    <section class="h-fit rounded-xl border border-slate-200 bg-white shadow-sm">
        <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">Heute abwesend</h2>
        {% if absentToday is empty %}
            <p class="px-5 py-4 text-sm text-slate-500">Alle sind da.</p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for absence in absentToday %}
                    <li class="flex items-center gap-3 px-5 py-3 text-sm">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-700">{{ absence.user.initials }}</span>
                        <span class="min-w-0">
                            <span class="block font-medium text-slate-900">{{ absence.user.name }}</span>
                            <span class="block text-slate-600">
                                <span class="inline-block h-2 w-2 rounded-sm" style="background: {{ absence_color(absence) }}"></span>
                                {{ absence_label(absence) }}{% if absence.status == 'requested' %} (beantragt){% endif %} · bis {{ absence.endDate|date('d.m.') }}
                            </span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
