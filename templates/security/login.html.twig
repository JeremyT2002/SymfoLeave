{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}
{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block body %}
<div class="grid items-start gap-8 pt-4 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:pt-12">
    {# Produkt-Vorstellung #}
    <section class="order-2 lg:order-1 lg:pt-6">
        <p class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">{{ icons.icon('sparkles', 'h-3.5 w-3.5') }}SymfoLeave</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">{{ 'login.hero_title'|trans }}</h1>
        <p class="mt-3 max-w-lg text-base text-muted">{{ 'app.tagline'|trans }}</p>
        <ul class="mt-8 space-y-4">
            {% for item in [
                {icon: 'clock', text: 'login.feature_request'},
                {icon: 'check', text: 'login.feature_approve'},
                {icon: 'shield', text: 'login.feature_calendar'},
            ] %}
                <li class="flex items-start gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-surface text-accent ring-1 ring-line">{{ icons.icon(item.icon, 'h-4 w-4') }}</span>
                    <span class="pt-1.5 text-sm text-fg">{{ item.text|trans }}</span>
                </li>
            {% endfor %}
        </ul>
        {# Kleine Kalender-Vorschau als Deko #}
        <div class="mt-10 hidden max-w-md rounded-2xl border border-line bg-surface p-4 shadow-sm sm:block" aria-hidden="true">
            {% for row in [
                {w: [0,1,1,1,0,0,0], c: '#2563eb'},
                {w: [0,0,0,1,1,0,0], c: '#0d9488'},
                {w: [1,1,0,0,0,0,0], c: '#64748b'},
                {w: [0,0,0,0,1,0,0], c: '#9333ea'},
            ] %}
                <div class="flex items-center gap-1.5 py-1">
                    <span class="h-2.5 w-16 rounded-full bg-surface-2"></span>
                    {% for on in row.w %}<span class="h-5 flex-1 rounded-md {{ loop.index > 5 ? 'cal-weekend' : (on ? '' : 'bg-surface-2') }}" {% if on and loop.index <= 5 %}style="background: {{ row.c }}"{% endif %}></span>{% endfor %}
                </div>
            {% endfor %}
        </div>
    </section>

    {# Anmeldung #}
    <div class="order-1 space-y-5 lg:order-2">
        {% if app_demo %}
            <section class="card p-5 sm:p-6">
                <h2 class="text-lg font-semibold text-fg">{{ 'login.demo_title'|trans }}</h2>
                <p class="mt-1 text-sm text-muted">{{ 'login.demo_text'|trans }}</p>
                <div class="mt-5 grid gap-2.5">
                    {% for role, info in {
                        employee: {label: 'login.as_employee', hint: 'login.as_employee_hint', icon: 'list'},
                        teamlead: {label: 'login.as_teamlead', hint: 'login.as_teamlead_hint', icon: 'check'},
                        admin: {label: 'login.as_admin', hint: 'login.as_admin_hint', icon: 'users'},
                    } %}
                        <form method="post" action="{{ path('app_demo_login', {role: role}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('demo-login') }}">
                            <button type="submit" class="group flex w-full items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-left transition hover:border-accent hover:bg-accent-soft">
                                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent text-on-accent dark:text-[#0b0d14]">{{ icons.icon(info.icon, 'h-5 w-5') }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="block font-semibold text-fg">{{ info.label|trans }}</span>
                                    <span class="block truncate text-xs text-muted">{{ info.hint|trans }}</span>
                                </span>
                                <span class="text-muted transition group-hover:translate-x-0.5 group-hover:text-accent">{{ icons.icon('arrow', 'h-4 w-4') }}</span>
                            </button>
                        </form>
                    {% endfor %}
                </div>
            </section>
            <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-muted"><span class="h-px flex-1 bg-line"></span>{{ 'login.or'|trans }}<span class="h-px flex-1 bg-line"></span></div>
        {% endif %}

        <section class="card p-5 sm:p-6">
            <h2 class="text-base font-semibold text-fg">{{ 'login.email_title'|trans }}</h2>
            {% if error %}
                <div role="alert" class="mt-3 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900 dark:border-red-400/20 dark:bg-red-400/10 dark:text-red-100">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <form method="post" action="{{ path('app_login') }}" class="mt-4 space-y-4">
                <div class="space-y-1.5">
                    <label for="username" class="label">{{ 'login.email'|trans }}</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required class="input">
                </div>
                <div class="space-y-1.5">
                    <label for="password" class="label">{{ 'login.password'|trans }}</label>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required class="input">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn-secondary w-full">{{ 'login.submit'|trans }}</button>
            </form>
        </section>
        <p class="text-center text-xs text-muted">
            {{ 'footer.by'|trans }} <a class="underline hover:text-fg" href="https://jeremythelen.de">Jeremy Thelen</a> ·
            <a class="underline hover:text-fg" href="https://github.com/JeremyT2002/SymfoLeave">{{ 'footer.source'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
