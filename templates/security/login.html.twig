{% extends 'base.html.twig' %}
{% block title %}Anmelden{% endblock %}
{% block body %}
<div class="mx-auto max-w-md pt-4 sm:pt-10">
    <div class="text-center">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-600 text-white text-xl font-semibold">S</span>
        <h1 class="mt-4 text-2xl font-semibold text-slate-900">SymfoLeave</h1>
        <p class="mt-1 text-slate-600">Abwesenheiten eintragen, genehmigen und im Team-Kalender sehen.</p>
    </div>

    {% if app_demo %}
        <section class="mt-8 rounded-xl border border-blue-200 bg-white p-5 shadow-sm">
            <h2 class="font-semibold text-slate-900">Direkt ausprobieren – ohne Registrierung</h2>
            <p class="mt-1 text-sm text-slate-600">Wähle eine Rolle. Du wirst als fiktive Person der „Nordlicht Software GmbH“ angemeldet.</p>
            <div class="mt-4 grid gap-2">
                {% for role, info in {
                    employee: {label: 'Als Mitarbeiter:in testen', hint: 'Max Müller · Urlaub beantragen, Kalender ansehen'},
                    teamlead: {label: 'Als Teamleitung testen', hint: 'Lena Hoffmann · Anträge des Teams genehmigen'},
                    admin: {label: 'Als Admin testen', hint: 'Sabine Wagner · Mitarbeitende & Teams verwalten'},
                } %}
                    <form method="post" action="{{ path('app_demo_login', {role: role}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('demo-login') }}">
                        <button type="submit" class="w-full rounded-lg bg-blue-600 px-4 py-3 text-left text-white hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2">
                            <span class="block font-medium">{{ info.label }}</span>
                            <span class="block text-xs text-blue-100">{{ info.hint }}</span>
                        </button>
                    </form>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-slate-900">Mit E-Mail anmelden</h2>
        {% if error %}
            <div class="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <form method="post" action="{{ path('app_login') }}" class="mt-4 space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium text-slate-700">E-Mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500">
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-slate-700">Passwort</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 font-medium text-slate-800 hover:bg-slate-50">Anmelden</button>
        </form>
    </section>
</div>
{% endblock %}
