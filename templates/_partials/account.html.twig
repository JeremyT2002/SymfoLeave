<section class="card p-5 sm:p-6">
    <div class="flex items-baseline justify-between gap-3">
        <h2 class="card-title">{{ 'account.title'|trans({'%year%': account.year}) }}</h2>
        <span class="text-xs text-muted tabular-nums">{{ account.usedPercent }} %</span>
    </div>
    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
        {% for key, value in {entitlement: account.entitlement, taken: account.taken, planned: account.planned} %}
            <div><dt class="text-xs text-muted">{{ ('account.' ~ key)|trans }}</dt><dd class="mt-0.5 text-2xl font-semibold tabular-nums text-fg">{{ value|days }}</dd></div>
        {% endfor %}
        <div><dt class="text-xs text-muted">{{ 'account.remaining'|trans }}</dt><dd class="mt-0.5 text-2xl font-semibold tabular-nums {{ account.negative ? 'text-red-600 dark:text-red-400' : 'text-accent' }}">{{ account.remaining|days }}</dd></div>
    </dl>
    <div class="mt-5 h-2 overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-valuenow="{{ account.usedPercent }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ 'account.progress'|trans }}">
        <div class="h-2 rounded-full {{ account.negative ? 'bg-red-500' : 'bg-accent' }}" style="width: {{ account.usedPercent }}%"></div>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted">{{ 'account.note'|trans }}</p>
</section>
