{% extends 'base.html.twig' %}
{% block title %}Team-Kalender{% endblock %}
{% block body %}
{% set teamParam = team ? team.id : 'all' %}
<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Team-Kalender</h1>
    <form method="get" class="flex items-center gap-2 text-sm">
        <input type="hidden" name="month" value="{{ calendar.month|date('Y-m') }}">
        <label for="team" class="text-slate-600">Team</label>
        <select id="team" name="team" onchange="this.form.submit()" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5">
            {% for t in teams %}<option value="{{ t.id }}" {{ team and team.id == t.id ? 'selected' }}>{{ t.name }}</option>{% endfor %}
            <option value="all" {{ team is null ? 'selected' }}>Alle Teams</option>
        </select>
        <noscript><button class="rounded-lg border px-2 py-1">Anzeigen</button></noscript>
    </form>
</div>

<div class="mt-4 flex items-center justify-between gap-2">
    <a class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm hover:bg-slate-50" href="{{ path('app_calendar', {month: calendar.previous|date('Y-m'), team: teamParam}) }}" aria-label="Vorheriger Monat">← <span class="hidden sm:inline">{{ calendar.previous|format_date(pattern: 'MMMM', locale: 'de') }}</span></a>
    <div class="text-center">
        <h2 class="text-lg font-semibold">{{ calendar.month|format_date(pattern: 'MMMM yyyy', locale: 'de') }}</h2>
        <a class="text-xs text-blue-700 underline" href="{{ path('app_calendar', {team: teamParam}) }}">Heute</a>
    </div>
    <a class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm hover:bg-slate-50" href="{{ path('app_calendar', {month: calendar.next|date('Y-m'), team: teamParam}) }}" aria-label="Nächster Monat"><span class="hidden sm:inline">{{ calendar.next|format_date(pattern: 'MMMM', locale: 'de') }}</span> →</a>
</div>

<div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="calendar min-w-full border-collapse text-xs">
        <thead>
            <tr>
                <th scope="col" class="sticky left-0 z-10 bg-white px-3 py-2 text-left font-semibold text-slate-700 min-w-40">Person</th>
                {% for day in calendar.days %}
                    <th scope="col" title="{{ day.holiday ?? '' }}" class="w-8 min-w-8 px-0.5 py-2 text-center font-medium {{ day.today ? 'bg-blue-600 text-white' : (day.holiday ? 'bg-rose-50 text-rose-800' : (day.weekend ? 'bg-slate-100 text-slate-500' : 'text-slate-700')) }}">
                        <span class="block">{{ day.date|format_date(pattern: 'EEEEEE', locale: 'de') }}</span>
                        <span class="block text-sm">{{ day.date|date('j') }}</span>
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in calendar.rows %}
                <tr class="border-t border-slate-100">
                    <th scope="row" class="sticky left-0 z-10 bg-white px-3 py-1.5 text-left font-medium text-slate-800 whitespace-nowrap">
                        {{ row.user.name }}{% if row.user.leadOf(row.user.team) %} <span class="text-slate-500 font-normal">(TL)</span>{% endif %}
                    </th>
                    {% for day in calendar.days %}
                        {% set key = day.date|date('Y-m-d') %}
                        {% set cell = row.cells[key] ?? null %}
                        <td class="h-8 p-0.5 text-center {{ day.holiday ? 'bg-rose-50' : (day.weekend ? 'bg-slate-100' : '') }}">
                            {% if cell and not day.weekend and not day.holiday %}
                                <span class="block h-6 rounded {{ cell.pending ? 'opacity-60 ring-1 ring-inset ring-slate-900/30' : '' }}"
                                      style="background: {% if cell.half %}linear-gradient(135deg, {{ cell.color }} 50%, transparent 50%){% else %}{{ cell.color }}{% endif %}"
                                      title="{{ row.user.name }}: {{ cell.label }}{{ cell.half ? ' (halber Tag)' }}{{ cell.pending ? ' – beantragt' }}{{ cell.comment ? ' – ' ~ cell.comment }}">
                                    <span class="sr-only">{{ cell.label }}{{ cell.pending ? ' (beantragt)' }}</span>
                                </span>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr><td colspan="{{ calendar.days|length + 1 }}" class="px-3 py-6 text-center text-slate-500">Keine Personen in diesem Team.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-600">
    {% for t in legend %}
        <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style="background: {{ t.color }}"></span>{{ t.name }}</span>
    {% endfor %}
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style="background: #64748b"></span>abwesend (Details privat)</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-blue-600 opacity-60 ring-1 ring-inset ring-slate-900/30"></span>beantragt</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style="background: linear-gradient(135deg, #2563eb 50%, transparent 50%)"></span>halber Tag</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-rose-100 border border-rose-200"></span>Feiertag</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-slate-100 border border-slate-200"></span>Wochenende</span>
</div>
{% endblock %}
