{% extends 'base.html.twig' %}
{% block title %}Mitarbeitende{% endblock %}
{% block body %}
<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Mitarbeitende</h1>
    <a href="{{ path('app_admin_user_new') }}" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">+ Person anlegen</a>
</div>
<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-600">
            <tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">E-Mail</th><th class="px-4 py-3">Team</th><th class="px-4 py-3">Rollen</th><th class="px-4 py-3 text-right">Urlaub/Jahr</th><th class="px-4 py-3"><span class="sr-only">Aktionen</span></th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            {% for user in users %}
                <tr>
                    <td class="px-4 py-3 font-medium">{{ user.name }}</td>
                    <td class="px-4 py-3 text-slate-600">{{ user.email }}</td>
                    <td class="px-4 py-3">{{ user.team ?? '–' }}</td>
                    <td class="px-4 py-3">
                        {% for role in user.storedRoles %}<span class="mr-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs">{{ {ROLE_ADMIN: 'Admin', ROLE_TEAM_LEAD: 'Teamleitung'}[role] ?? role }}</span>{% else %}<span class="text-slate-500">Mitarbeiter:in</span>{% endfor %}
                    </td>
                    <td class="px-4 py-3 text-right tabular-nums">{{ user.annualVacationDays }}</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                        <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="text-blue-700 hover:underline">Bearbeiten</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
