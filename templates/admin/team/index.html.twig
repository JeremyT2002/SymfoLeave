{% extends 'base.html.twig' %}
{% block title %}Teams{% endblock %}
{% block body %}
<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Teams</h1>
    <a href="{{ path('app_admin_team_new') }}" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">+ Team anlegen</a>
</div>
<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-600">
            <tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">Teamleitung</th><th class="px-4 py-3 text-right">Mitglieder</th><th class="px-4 py-3"><span class="sr-only">Aktionen</span></th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            {% for team in teams %}
                <tr>
                    <td class="px-4 py-3 font-medium">{{ team.name }}</td>
                    <td class="px-4 py-3">{{ team.lead ?? '–' }}</td>
                    <td class="px-4 py-3 text-right tabular-nums">{{ team.members|length }}</td>
                    <td class="px-4 py-3 text-right"><a href="{{ path('app_admin_team_edit', {id: team.id}) }}" class="text-blue-700 hover:underline">Bearbeiten</a></td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="px-4 py-6 text-center text-slate-500">Noch keine Teams.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
