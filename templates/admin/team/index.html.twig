{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}
{% block title %}{{ 'admin.teams_title'|trans }}{% endblock %}
{% block body %}
<div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{{ 'admin.teams_title'|trans }}</h1>
    <a href="{{ path('app_admin_team_new') }}" class="btn-primary">{{ icons.icon('plus', 'h-4 w-4') }}{{ 'admin.new_team'|trans }}</a>
</div>
{% if teams is empty %}
    <p class="card mt-6 px-5 py-8 text-center text-sm text-muted">{{ 'admin.teams_empty'|trans }}</p>
{% else %}
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {% for team in teams %}
            <a href="{{ path('app_admin_team_edit', {id: team.id}) }}" class="card group block p-5 transition hover:border-accent/50">
                <span class="flex items-start justify-between gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent">{{ icons.icon('team', 'h-5 w-5') }}</span>
                    <span class="text-muted transition group-hover:text-accent">{{ icons.icon('pencil', 'h-4 w-4') }}<span class="sr-only">{{ 'admin.edit'|trans }}</span></span>
                </span>
                <span class="mt-4 block text-lg font-semibold text-fg">{{ team.name }}</span>
                <span class="mt-1 block text-sm text-muted">{{ 'admin.lead'|trans }}: <span class="text-fg">{{ team.lead ?? '–' }}</span></span>
                <span class="mt-0.5 block text-sm text-muted">{{ 'admin.members'|trans }}: <span class="tabular-nums text-fg">{{ team.members|length }}</span></span>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
