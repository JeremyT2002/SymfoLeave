<!DOCTYPE html>
<html lang="de" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SymfoLeave{% endblock %} · SymfoLeave</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%232563eb%22/><text x=%2264%22 y=%2290%22 font-size=%2272%22 text-anchor=%22middle%22 fill=%22white%22 font-family=%22sans-serif%22>S</text></svg>">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="h-full text-slate-800 antialiased">
{% if app_demo %}
    <div class="bg-amber-100 text-amber-900 text-center text-xs sm:text-sm py-1.5 px-4 border-b border-amber-200">
        Demo – alle Daten sind fiktiv und werden täglich zurückgesetzt.
    </div>
{% endif %}

{% if app.user %}
    {% set nav = [
        {route: 'app_dashboard', label: 'Übersicht'},
        {route: 'app_absence_index', label: 'Meine Abwesenheiten'},
        {route: 'app_calendar', label: 'Team-Kalender'},
    ] %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set nav = nav|merge([{route: 'app_admin_user_index', label: 'Mitarbeitende'}, {route: 'app_admin_team_index', label: 'Teams'}]) %}
    {% endif %}
    {% set current = app.request.attributes.get('_route') %}
    <header class="bg-white border-b border-slate-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <div class="flex h-14 items-center justify-between gap-4">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 font-semibold text-slate-900">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-blue-600 text-white text-sm">S</span>
                    SymfoLeave
                </a>
                <nav class="hidden md:flex items-center gap-1 text-sm" aria-label="Hauptnavigation">
                    {% for item in nav %}
                        <a href="{{ path(item.route) }}" class="rounded-md px-3 py-2 {{ current starts with item.route|replace({'_index': ''}) ? 'bg-slate-100 text-slate-900 font-medium' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' }}">{{ item.label }}</a>
                    {% endfor %}
                </nav>
                <div class="flex items-center gap-3 text-sm">
                    <span class="hidden sm:inline text-slate-600">
                        {{ app.user.name }}
                        <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{{ is_granted('ROLE_ADMIN') ? 'Admin' : (is_granted('ROLE_TEAM_LEAD') ? 'Teamleitung' : 'Mitarbeiter:in') }}</span>
                    </span>
                    <a href="{{ path('app_logout') }}" class="rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50">Abmelden</a>
                </div>
            </div>
            <nav class="md:hidden flex gap-1 overflow-x-auto pb-2 text-sm" aria-label="Hauptnavigation mobil">
                {% for item in nav %}
                    <a href="{{ path(item.route) }}" class="whitespace-nowrap rounded-md px-3 py-1.5 {{ current starts with item.route|replace({'_index': ''}) ? 'bg-slate-100 text-slate-900 font-medium' : 'text-slate-600' }}">{{ item.label }}</a>
                {% endfor %}
            </nav>
        </div>
    </header>
{% endif %}

<main class="mx-auto max-w-7xl px-4 sm:px-6 py-6 sm:py-8">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div role="status" class="mb-4 rounded-lg border px-4 py-3 text-sm {{ {success: 'border-green-200 bg-green-50 text-green-900', warning: 'border-amber-200 bg-amber-50 text-amber-900', error: 'border-red-200 bg-red-50 text-red-900'}[type] ?? 'border-slate-200 bg-white' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<footer class="mx-auto max-w-7xl px-4 sm:px-6 pb-8 text-xs text-slate-500">
    SymfoLeave · Portfolio-Projekt von <a class="underline hover:text-slate-700" href="https://jeremythelen.de">Jeremy Thelen</a> ·
    <a class="underline hover:text-slate-700" href="https://github.com/JeremyT2002/SymfoLeave">Quellcode auf GitHub</a>
</footer>
</body>
</html>
