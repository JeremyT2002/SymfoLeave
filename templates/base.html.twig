{% import '_partials/icons.html.twig' as icons %}
{%- set locale = app.request.locale -%}
<!DOCTYPE html>
<html lang="{{ locale }}" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}SymfoLeave{% endblock %} · SymfoLeave</title>
    <meta name="theme-color" content="#4f46e5">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2232%22 fill=%22%234f46e5%22/><path d=%22M40 76c0-20 14-36 34-40 2 22-12 40-34 40Zm0 0 22-18%22 stroke=%22white%22 stroke-width=%2210%22 fill=%22none%22 stroke-linecap=%22round%22/></svg>">
    <script>
        {# Theme vor dem ersten Zeichnen setzen: gespeicherte Wahl, sonst System #}
        (function () {
            try {
                var t = localStorage.getItem('symfoleave-theme');
                if (t === 'dark' || (t !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) {}
        })();
    </script>
    {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endblock %}
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="min-h-full">

{# ---------- gemeinsame Bausteine ---------- #}
{% set demo_banner %}
    {% if app_demo %}
        <div class="bg-accent-soft px-4 py-1.5 text-center text-xs font-medium text-accent">{{ 'demo.banner'|trans }}</div>
    {% endif %}
{% endset %}
{% macro controls(locale) %}
    {% import '_partials/icons.html.twig' as icons %}
    <details class="relative">
        <summary class="icon-btn cursor-pointer list-none w-auto gap-1.5 px-2.5 text-xs font-semibold uppercase" aria-label="{{ 'header.language'|trans }}">
            {{ icons.icon('globe', 'h-4 w-4') }}{{ locale }}
        </summary>
        <div class="absolute right-0 z-50 mt-2 w-40 overflow-hidden rounded-xl border border-line bg-surface p-1 shadow-lg">
            {% for code, name in {de: 'Deutsch', en: 'English', fr: 'Français'} %}
                <a href="{{ path('app_locale', {locale: code, redirect: app.request.requestUri}) }}" lang="{{ code }}" hreflang="{{ code }}"
                   class="flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-surface-2 {{ code == locale ? 'font-semibold text-accent' : 'text-fg' }}">
                    {{ name }}{% if code == locale %}{{ icons.icon('check', 'h-4 w-4') }}{% endif %}
                </a>
            {% endfor %}
        </div>
    </details>
    <button type="button" class="icon-btn" data-controller="theme" data-action="theme#toggle" aria-label="{{ 'header.theme'|trans }}" title="{{ 'header.theme'|trans }}">
        <span class="dark:hidden">{{ icons.icon('moon') }}</span>
        <span class="hidden dark:inline">{{ icons.icon('sun') }}</span>
    </button>
{% endmacro %}

{% set logo %}
    <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2.5 font-semibold tracking-tight text-fg">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-accent text-on-accent shadow-sm dark:text-[#0b0d14]">{{ icons.icon('leaf', 'h-5 w-5') }}</span>
        SymfoLeave
    </a>
{% endset %}

{% if app.user %}
    {% set current = app.request.attributes.get('_route') %}
    {% set nav = [
        {route: 'app_dashboard', label: 'nav.dashboard', short: 'nav.dashboard', icon: 'home'},
        {route: 'app_absence_index', label: 'nav.absences', short: 'nav.absences_short', icon: 'list'},
        {route: 'app_calendar', label: 'nav.calendar', short: 'nav.calendar_short', icon: 'calendar'},
    ] %}
    {% set admin_nav = is_granted('ROLE_ADMIN') ? [
        {route: 'app_admin_user_index', label: 'nav.users', icon: 'users'},
        {route: 'app_admin_team_index', label: 'nav.teams', icon: 'team'},
    ] : [] %}
    {% set role_label = is_granted('ROLE_ADMIN') ? 'role.admin' : (is_granted('ROLE_TEAM_LEAD') ? 'role.team_lead' : 'role.employee') %}

    {# Desktop: feste Seitenleiste #}
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-line bg-surface lg:flex">
        <div class="flex h-16 items-center px-5">{{ logo }}</div>
        <div class="px-4">
            <a href="{{ path('app_absence_new') }}" class="btn-primary w-full">{{ icons.icon('plus', 'h-4 w-4') }}{{ 'nav.new_absence'|trans }}</a>
        </div>
        <nav class="mt-6 flex-1 space-y-1 px-3" aria-label="{{ 'nav.main'|trans }}">
            {% for item in nav %}
                <a href="{{ path(item.route) }}" class="nav-link {{ current starts with item.route|replace({'_index': ''}) ? 'nav-link-active' }}" {% if current == item.route %}aria-current="page"{% endif %}>
                    {{ icons.icon(item.icon) }}{{ item.label|trans }}
                </a>
            {% endfor %}
            {% if admin_nav %}
                <p class="px-3 pt-6 pb-2 text-xs font-semibold uppercase tracking-wider text-muted">{{ 'nav.admin'|trans }}</p>
                {% for item in admin_nav %}
                    <a href="{{ path(item.route) }}" class="nav-link {{ current starts with item.route|replace({'_index': ''}) ? 'nav-link-active' }}">
                        {{ icons.icon(item.icon) }}{{ item.label|trans }}
                    </a>
                {% endfor %}
            {% endif %}
        </nav>
        <p class="px-5 pb-5 text-xs leading-relaxed text-muted">
            {{ 'footer.by'|trans }} <a class="underline hover:text-fg" href="https://jeremythelen.de">Jeremy Thelen</a><br>
            <a class="underline hover:text-fg" href="https://github.com/JeremyT2002/SymfoLeave">{{ 'footer.source'|trans }}</a>
        </p>
    </aside>

    <div class="lg:pl-64">
        {{ demo_banner }}
        <header class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur-md">
            <div class="flex h-16 items-center gap-2 px-4 sm:px-6 lg:px-8">
                <div class="lg:hidden">{{ logo }}</div>
                <div class="ml-auto flex items-center gap-1">
                    {{ _self.controls(locale) }}
                    <div class="ml-1 flex items-center gap-3 border-l border-line pl-3">
                        <span class="hidden h-9 w-9 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent sm:inline-flex">{{ app.user.initials }}</span>
                        <span class="hidden leading-tight sm:block">
                            <span class="block text-sm font-medium text-fg">{{ app.user.name }}</span>
                            <span class="block text-xs text-muted">{{ role_label|trans }}</span>
                        </span>
                        <span class="sr-only sm:hidden">{{ app.user.name }} · {{ role_label|trans }}</span>
                        <a href="{{ path('app_logout') }}" class="icon-btn" aria-label="{{ 'header.logout'|trans }}" title="{{ 'header.logout'|trans }}">{{ icons.icon('logout') }}</a>
                    </div>
                </div>
            </div>
        </header>

        <main class="mx-auto max-w-6xl px-4 pt-6 pb-28 sm:px-6 lg:px-8 lg:pt-8 lg:pb-12">
            {{ include('_partials/flashes.html.twig') }}
            {% block body %}{% endblock %}
        </main>
    </div>

    {# Handy: Navigation unten, "+" in der Mitte #}
    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden" aria-label="{{ 'nav.main'|trans }}">
        <div class="mx-auto flex max-w-md items-end justify-around px-2 pt-1.5 pb-1.5">
            {% set mobile = nav|slice(0, 2)|merge([{route: 'app_absence_new', short: 'nav.new_absence', icon: 'plus', cta: true}])|merge(nav|slice(2))|merge(admin_nav ? [{route: 'app_admin_user_index', short: 'nav.admin', icon: 'users'}] : []) %}
            {% for item in mobile %}
                {% set active = current starts with item.route|replace({'_index': ''}) or (item.route == 'app_admin_user_index' and current starts with 'app_admin') %}
                {% if item.cta is defined %}
                    <a href="{{ path(item.route) }}" class="-mt-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent text-on-accent shadow-lg shadow-accent/30 dark:text-[#0b0d14]" aria-label="{{ item.short|trans }}">{{ icons.icon('plus', 'h-6 w-6') }}</a>
                {% else %}
                    <a href="{{ path(item.route) }}" class="flex min-w-14 flex-col items-center gap-0.5 rounded-xl px-2 py-1.5 text-[11px] font-medium {{ active ? 'text-accent' : 'text-muted' }}">
                        {{ icons.icon(item.icon) }}{{ item.short|trans }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </nav>
{% else %}
    {{ demo_banner }}
    <header class="mx-auto flex h-16 max-w-6xl items-center px-4 sm:px-6">
        {{ logo }}
        <div class="ml-auto flex items-center gap-1">{{ _self.controls(locale) }}</div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
        {{ include('_partials/flashes.html.twig') }}
        {% block anonymous_body %}{{ block('body') }}{% endblock %}
    </main>
{% endif %}
</body>
</html>
